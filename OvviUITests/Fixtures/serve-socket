# Sourced by a fixture herdr, with $HERDR the herdr it runs: the app connects to herdr's socket, so the `session list`
# of the app's session names a socket of `bridge-socket`'s instead, whose connections run the fixture's
# `remote-api-bridge`. Only a named session's path is rewritten (the default session's has no `sessions/`).
case "$*" in "--session $2 session list"*)
    s=/tmp/ovvi-e2e-bridge-$PPID-$2.sock
    [ -S "$s" ] || { nohup "${0%/*}/../bridge-socket" "$s" "$0" "$2" $PPID >/dev/null 2>&1 &
        i=0; while [ ! -S "$s" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i + 1)); done; }
    set -o pipefail
    "$HERDR" "$@" | sed "s#\"socket_path\":\"[^\"]*/sessions/$2/herdr.sock\"#\"socket_path\":\"$s\"#"
    exit
esac
