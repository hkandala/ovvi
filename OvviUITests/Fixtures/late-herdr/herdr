#!/bin/sh
# The real herdr ($OVVI_E2E_HERDR), whose `session list` answers 2 s late, as over a slow link; the find bar's read of
# a pane's recent text answers 3 s late (keys come sorted) and, just before, touches $OVVI_E2E_LATE_MARK if it is set.
case "$*" in *"session list"*) sleep 2 ;; esac
case "$*" in *remote-api-bridge*)
    IFS= read -r line
    case "$line" in *'"source":"recent"'*) sleep 3; [ -n "$OVVI_E2E_LATE_MARK" ] && touch "$OVVI_E2E_LATE_MARK" ;; esac
    { printf '%s\n' "$line"; cat; } | "$OVVI_E2E_HERDR" "$@"
    exit
esac
exec "$OVVI_E2E_HERDR" "$@"
