#!/bin/sh
# The real herdr ($OVVI_E2E_HERDR) with the failures that files in $OVVI_E2E_FLAGS switch on: `terminal` fails every
# terminal stream, as a herdr updated under a running server does; `down` fails every run. Each stream open is a line
# in `opens`.
case "$*" in *"terminal session"*) echo "$*" >>"$OVVI_E2E_FLAGS/opens" ;; esac
if [ -e "$OVVI_E2E_FLAGS/down" ]; then
    echo "herdr is down" >&2
    exit 1
fi
case "$*" in *"terminal session"*) if [ -e "$OVVI_E2E_FLAGS/terminal" ]; then
    echo "protocol mismatch" >&2
    exit 1
fi ;; esac
HERDR=$OVVI_E2E_HERDR
# The app connects to herdr's socket: `session list` names one of `bridge-socket`'s instead, whose connections run this.
case "$*" in "--session $2 session list"*)
    s=/tmp/ovvi-e2e-bridge-$PPID-$2.sock
    [ -S "$s" ] || { nohup "${0%/*}/../bridge-socket" "$s" "$0" "$2" $PPID >/dev/null 2>&1 &
        i=0; while [ ! -S "$s" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i + 1)); done; }
    set -o pipefail
    "$HERDR" "$@" | sed "s#\"socket_path\":\"[^\"]*/sessions/$2/herdr.sock\"#\"socket_path\":\"$s\"#"
    exit
esac
exec "$OVVI_E2E_HERDR" "$@"
