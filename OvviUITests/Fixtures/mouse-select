#!/usr/bin/env python3
# A stand-in for a program that reads the mouse and selects on its own, as pi does: SGR mouse mode with drags, a row
# of words, and its selection from the press's cell to the pointer's, both taken, in reverse video. Its first row
# counts the drags and releases. Each frame ends with a reverse-video mark (herdr draws it white), 6 cells from column
# 30 + 8 x releases.
import os, re, sys, tty

tty.setraw(0)
words = "abc " * 15
anchor = focus = None
drags = releases = 0


def draw():
    row = words
    if anchor is not None and anchor != focus:
        start, end = sorted((anchor, focus))
        row = words[:start] + "\x1b[7m" + words[start:end + 1] + "\x1b[0m" + words[end + 1:]
    mark = f"\x1b[1;{31 + 8 * releases}H\x1b[7m      \x1b[0m"
    sys.stdout.write(f"\x1b[H\x1b[2Jdrags {drags} releases {releases}\r\n{row}{mark}")
    sys.stdout.flush()


sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?1002h\x1b[?1006h")
draw()
while (data := os.read(0, 1024)) and b"q" not in data:
    for button, column, _, kind in re.findall(rb"\x1b\[<(\d+);(\d+);(\d+)([Mm])", data):
        button, column = int(button), int(column) - 1
        if kind == b"m":
            focus, releases = column, releases + 1
        elif button == 32:
            focus, drags = column, drags + 1
        elif button == 0:
            anchor = focus = column
    draw()
sys.stdout.write("\x1b[?1002l\x1b[?1006l\x1b[?25h\x1b[?1049l")
