#!/usr/bin/env python3
# A stand-in for a program that reads the mouse and selects on its own, as pi does: SGR mouse mode with drags, a row
# of letters, and its selection from the press's cell to the pointer's, both taken, in reverse video. Its first row
# counts the drags and releases; after a release it ends with a reverse-video mark, which herdr draws white.
import os, re, sys, tty

tty.setraw(0)
letters = "".join(chr(ord("a") + i % 26) for i in range(60))
anchor = focus = None
drags = releases = 0
released = False


def draw():
    row = letters
    if anchor is not None and anchor != focus:
        start, end = sorted((anchor, focus))
        row = letters[:start] + "\x1b[7m" + letters[start:end + 1] + "\x1b[0m" + letters[end + 1:]
    mark = "  \x1b[7m      \x1b[0m" if released else ""
    sys.stdout.write(f"\x1b[H\x1b[2Jdrags {drags} releases {releases}{mark}\r\n{row}")
    sys.stdout.flush()


sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[?1002h\x1b[?1006h")
draw()
while (data := os.read(0, 1024)) and b"q" not in data:
    for button, column, _, kind in re.findall(rb"\x1b\[<(\d+);(\d+);(\d+)([Mm])", data):
        button, column = int(button), int(column) - 1
        if kind == b"m":
            focus, releases, released = column, releases + 1, True
        elif button == 32:
            focus, drags = column, drags + 1
        elif button == 0:
            anchor = focus = column
            released = False
    draw()
sys.stdout.write("\x1b[?1002l\x1b[?1006l\x1b[?25h\x1b[?1049l")
