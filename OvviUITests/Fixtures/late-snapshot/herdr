#!/bin/sh
# The next herdr on PATH, whose snapshots answer 2 s late once the session has a space: a Start's own checks (no space
# yet) answer at once, the session's first read after it late. launchd starts the server through this too, with the
# same PATH and no other variable.
herdr=$(PATH=${PATH#*:} command -v herdr)
HERDR=$herdr
# The app connects to herdr's socket: `session list` names one of `bridge-socket`'s instead, whose connections run this.
case "$*" in "--session $2 session list"*)
    s=/tmp/ovvi-e2e-bridge-$PPID-$2.sock
    [ -S "$s" ] || { nohup "${0%/*}/../bridge-socket" "$s" "$0" "$2" $PPID >/dev/null 2>&1 &
        i=0; while [ ! -S "$s" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i + 1)); done; }
    set -o pipefail
    "$HERDR" "$@" | sed "s#\"socket_path\":\"[^\"]*/sessions/$2/herdr.sock\"#\"socket_path\":\"$s\"#"
    exit
esac
case "$*" in *remote-api-bridge*)
    set -o pipefail
    "$herdr" "$@" | {
        IFS= read -r reply || exit 0
        case "$reply" in *'"session_snapshot"'*'"workspaces":[]'*) ;; *'"session_snapshot"'*) sleep 2 ;; esac
        printf '%s\n' "$reply"
        exec cat
    }
    exit
esac
exec "$herdr" "$@"
