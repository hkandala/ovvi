{
  "name": "ci-runs",
  "version": "0.1.0",
  "private": true,
  "description": "A project's CI runs, from its ci.json.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --splitting --format=esm --minify --sourcemap --target=safari18 --log-level=warning --outdir=dist",
    "dev": "npm run build -- --watch",
    "check": "tsc -p ."
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@ovvi/plugin-api": "*"
  },
  "peerDependenciesMeta": {
    "@ovvi/plugin-api": {
      "optional": true
    }
  },
  "ovvi": {
    "id": "ci-runs",
    "name": "CI Runs",
    "api": 3,
    "entry": "dist/main.js",
    "icon": "checklist",
    "opens": {
      "files": [
        "ci.json"
      ],
      "priority": "default"
    },
    "header": [
      {
        "id": "count",
        "type": "text",
        "style": "dim"
      }
    ]
  }
}
